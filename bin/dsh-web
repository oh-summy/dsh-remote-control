#!/usr/bin/env bash
# dsh-web — remote control 一站式命令
# 用法: dsh-web start|stop|restart|status|logs|password|url|install|tunnel-setup|rotate-password|autostart
#   start           启动全链路，终端打印 URL + 密码后返回（通知照常推飞书）
#   stop            停止全链路
#   restart         停止并重新启动（URL 会变，飞书会推新卡片）
#   status          查看各组件状态
#   logs            dsh-web logs [caddy|cloudflared|auth|watchdog|selfheal|notify]  尾部日志
#   password        打印访问密码
#   url             打印当前入口 URL
#   install         安装/修复（依赖、配置、凭据、命令行链接）
#   tunnel-setup    引导创建 Named Tunnel（固定域名）
#   rotate-password 轮换访问密码（生成新密码并重启服务）
#   autostart       安装/卸载 launchd 开机自启（Mac）
set -u

# 兼容经由 symlink（PATH）调用：解析真实路径定位仓库
SOURCE="${0:-}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  case "$SOURCE" in /*) ;; *) SOURCE="$DIR/$SOURCE" ;; esac
done
REPO_DIR="$(cd "$(dirname "$SOURCE")/.." && pwd)"

# 确定性终止常驻看门狗：TERM 落在它的 sleep 30 内时 trap 延迟生效（进程可能
# 幸存并继续值守/自愈），1s 宽限后 SIGKILL 保证退出；残留 pid 文件按内容
# 校验后清理（防误删 launchd 重拉的新实例刚认领的 pid）
stop_resident_watchdog() {
  local wpid
  wpid="$(cat "$HOME/.remote-control/run/watchdog.pid" 2>/dev/null || true)"
  [ -n "$wpid" ] || return 0
  kill "$wpid" 2>/dev/null || true
  sleep 1
  kill -9 "$wpid" 2>/dev/null || true
  [ "$(cat "$HOME/.remote-control/run/watchdog.pid" 2>/dev/null || true)" = "$wpid" ] && \
    rm -f "$HOME/.remote-control/run/watchdog.pid"
  return 0
}

cmd="${1:-help}"
case "$cmd" in
  start)
    "$REPO_DIR/bin/up.sh"
    ;;
  stop)    exec "$REPO_DIR/bin/down.sh" ;;
  status)  exec "$REPO_DIR/bin/status.sh" ;;
  restart)
    "$REPO_DIR/bin/down.sh"
    sleep 1
    "$REPO_DIR/bin/up.sh"
    ;;
  logs)
    name="${2:-all}"
    if [ "$name" = all ]; then
      for g in "$HOME/.remote-control/logs"/*.log; do
        echo "═══ $(basename "$g") ═══"; tail -n 10 "$g"
      done
    elif [ "$name" = caddy ]; then
      # caddy.log 由 Caddyfile 配置（WARN 级，可能尚未产生）；stdout 恒有
      shown=0
      for f in "$HOME/.remote-control/logs/caddy.log" \
               "$HOME/.remote-control/logs/caddy.stdout.log"; do
        if [ -f "$f" ]; then
          echo "── $(basename "$f") ──"
          tail -n "${3:-40}" "$f"
          shown=1
        fi
      done
      [ "$shown" = "0" ] && echo "(暂无 caddy 日志 — caddy.log 仅在 WARN 及以上级别产生，无警告时可能不存在)"
    else
      case "$name" in
        cloudflared) f="$HOME/.remote-control/logs/cloudflared.log" ;;
        auth)        f="$HOME/.remote-control/logs/auth.log" ;;
        watchdog)    f="$HOME/.remote-control/logs/watchdog.log" ;;
        selfheal)    f="$HOME/.remote-control/logs/selfheal.log" ;;
        notify)      f="$HOME/.remote-control/logs/notify.log" ;;
        *) echo "未知日志: ${name}（可选 caddy|cloudflared|auth|watchdog|selfheal|notify|all）"; exit 1 ;;
      esac
      tail -n "${3:-40}" "$f"
    fi
    ;;
  password) cat "$HOME/.remote-control/password" ;;
  url)      cat "$HOME/.remote-control/run/url" 2>/dev/null || echo "(未启动)" ;;
  install)
    "$REPO_DIR/scripts/install.sh" || exit 1
    # 迁移：旧版（≤v0.2.x）autostart 装的是「up.sh + KeepAlive=false」的 plist，
    # 升级后不会自动变化。检测到已装自启则重渲染并 reload，切换到常驻守护模式
    if [ "$(uname -s)" = "Darwin" ] \
       && [ -f "$HOME/Library/LaunchAgents/com.dsh-remote-control.plist" ]; then
      echo "[dsh-web] 检测到已安装的开机自启，升级为常驻守护模式 ..."
      "$SOURCE" autostart
    fi
    ;;
  tunnel-setup)
    echo "[dsh-web] Named Tunnel 设置向导"
    echo ""
    echo "步骤 1: 登录 Cloudflare（如未登录）"
    echo "  cloudflared tunnel login"
    echo ""
    echo "步骤 2: 创建隧道"
    echo "  cloudflared tunnel create <隧道名>"
    echo ""
    echo "步骤 3: 配置 DNS 路由"
    echo "  cloudflared tunnel route dns <隧道名> <域名>"
    echo ""
    echo "步骤 4: 编辑 ~/.remote-control/rc.env，设置："
    echo "  RC_TUNNEL_NAME=<隧道名>"
    echo "  RC_TUNNEL_HOSTNAME=<域名>"
    echo ""
    echo "步骤 5: 重启服务"
    echo "  dsh-web restart"
    ;;
  rotate-password)
    "$REPO_DIR/scripts/rotate-password.sh"
    ;;
  autostart)
    # 平台检查
    [ "$(uname -s)" = "Darwin" ] || { echo "[dsh-web] ✗ autostart 仅支持 macOS"; exit 1; }
    PLIST="$HOME/Library/LaunchAgents/com.dsh-remote-control.plist"
    mkdir -p "$HOME/Library/LaunchAgents"
    if [ "${2:-}" = "off" ]; then
      # 与 on 同序：先落 stopped → unload（job 移除后 launchd 不可能再重拉，
      # 不留"旧实例死亡到 unload 之间被重拉幸存"的窗口）→ 确定性终止 holder
      # → 清标志。无标志 TERM 免疫的看门狗由 SIGKILL 兜底
      mkdir -p "$HOME/.remote-control/run"
      touch "$HOME/.remote-control/run/stopped"
      launchctl unload "$PLIST" 2>/dev/null || true
      stop_resident_watchdog
      rm -f "$PLIST" "$HOME/.remote-control/run/stopped"
      echo "[dsh-web] ✓ 已卸载开机自启（常驻看门狗已一并停止）"
    else
      # 与 off 同序：先落 stopped 再确定性终止旧看门狗（无标志时它对 TERM
      # 免疫，直接 unload 会把 active 实例孤儿化到 launchd 之外），
      # load 新任务后再清标志
      mkdir -p "$HOME/.remote-control/run"
      touch "$HOME/.remote-control/run/stopped"
      launchctl unload "$PLIST" 2>/dev/null || true
      stop_resident_watchdog
      # 使用 | 作为 sed 分隔符避免 # 冲突
      sed -e "s|__REPO_DIR__|$REPO_DIR|g" -e "s|__RC_HOME__|$HOME/.remote-control|g" \
        "$REPO_DIR/etc/com.dsh-remote-control.plist" > "$PLIST" || {
        echo "[dsh-web] ✗ 生成 plist 失败"
        rm -f "$HOME/.remote-control/run/stopped"
        exit 1
      }
      if launchctl load "$PLIST" 2>/dev/null; then
        rm -f "$HOME/.remote-control/run/stopped"
        echo "[dsh-web] ✓ 已安装开机自启（launchd，常驻守护模式）"
        echo "[dsh-web]   关闭: dsh-web autostart off"
      else
        rm -f "$HOME/.remote-control/run/stopped"
        echo "[dsh-web] ✗ launchctl load 失败"
        exit 1
      fi
    fi
    ;;
  *)
    sed -n '2,14p' "$SOURCE" | sed 's/^# \{0,1\}//'
    exit 1
    ;;
esac
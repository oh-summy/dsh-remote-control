<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.dsh-remote-control</string>
    <key>ProgramArguments</key>
    <array>
        <string>__REPO_DIR__/bin/up.sh</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <false/>
    <key>StandardOutPath</key>
    <string>__RC_HOME__/logs/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>__RC_HOME__/logs/launchd.err.log</string>
    <key>WorkingDirectory</key>
    <string>__REPO_DIR__</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:__RC_HOME__/bin</string>
    </dict>
</dict>
</plist>

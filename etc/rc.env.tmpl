# remote-control 运行时配置（含敏感信息，权限 600，不进 git）
RC_HOME="__RC_HOME__"
RC_UPSTREAM="127.0.0.1:3080"  # host:port only, no scheme (e.g. 127.0.0.1:3080)
# 注意：改端口需同步修改 etc/Caddyfile 里的站点地址 :4080
RC_LISTEN="127.0.0.1:4080"
# 飞书通知（v2 主通道：bot 私发，固定 APP 凭据不过期）
# 填收通知人的 open_id（ou_ 开头，可从 lark-cli 的发送结果或应用后台拿到）
RC_FEISHU_OPEN_ID=""
# 兜底通道：群自定义机器人 Webhook（可留空）
RC_FEISHU_WEBHOOK=""
# full=通知里带完整密码 | mask=只带后 4 位
RC_NOTIFY_PASSWORD="full"
# true = auto-start DSH web if not running (default); false = manual
RC_AUTOSTART_DSH="true"

# ---- Named Tunnel（固定域名，可选）----
# 设置后使用 Named Tunnel 替代 Quick Tunnel，URL 固定不变
# 创建步骤：dsh-web tunnel-setup 会引导完成
# RC_TUNNEL_NAME="my-dsh-tunnel"
# RC_TUNNEL_HOSTNAME="dsh.example.com"
RC_TUNNEL_NAME=""
RC_TUNNEL_HOSTNAME=""